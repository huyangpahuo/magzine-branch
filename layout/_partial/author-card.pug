//- Author Card Section
if theme.author_card && theme.author_card.enable
  section.author-card-section(class=theme.hero && theme.hero.enable ? "author-card-section--with-hero" : "author-card-section--without-hero")
    .author-card-container
      //- 拉绳折叠容器:点击下方拉绳,名片收起/弹出(像拉绳台灯)
      .author-card-foldable
        .author-card(
          class=theme.author_card.background_image ? "author-card--with-bg" : "",
          style=theme.author_card.background_image ? "background-image: url('" + url_for(theme.author_card.background_image) + "')" : "",
          class=theme.author_card.width === "large" ? "author-card--large" : "",
          class=(!theme.author_card.background_image && theme.author_card.background_animation && theme.author_card.background_animation.enable) ? "author-card--animated" : ""
        )
          // 动态背景容器
          if (!theme.author_card.background_image && theme.author_card.background_animation && theme.author_card.background_animation.enable)
            .author-card-bg(
              class="author-card-bg--" + (theme.author_card.background_animation.type || "particles"),
              class=theme.author_card.background_animation.interactive ? "author-card-bg--interactive" : "",
              class="author-card-bg--" + (theme.author_card.background_animation.density || "medium"),
              class="author-card-bg--" + (theme.author_card.background_animation.color_scheme === "auto" ? "author-card-bg--auto" : ("author-card-bg--" + (theme.author_card.background_animation.color_scheme || "light")))
            )

          if theme.author_card.avatar
            .author-avatar
              img(src=url_for(theme.author_card.avatar), alt="Author Avatar")
          .author-info
            //- 名字/简介是 _config.yml 的配置中文,走 data-i18n-value 值索引
            //- (site.owner_name / site.tagline);想要英文可加 name_en/bio_en 字段
            h2.author-name(data-i18n-value=theme.author_card.name || "Author Name")= theme.author_card.name || "Author Name"
            p.author-bio(data-i18n-value=theme.author_card.bio || "Author bio goes here...")= theme.author_card.bio || "Author bio goes here..."
            .author-social
              if theme.social.github
                a.social-link(href=theme.social.github, target="_blank", rel="noopener", data-title="GitHub")
                  i.fab.fa-github
              if theme.social.twitter
                a.social-link(href=theme.social.twitter, target="_blank", rel="noopener", data-title="Twitter")
                  i.fab.fa-twitter
              if theme.social.instagram
                a.social-link(href=theme.social.instagram, target="_blank", rel="noopener", data-title="Instagram")
                  i.fab.fa-instagram
              if theme.social.linkedin
                a.social-link(href=theme.social.linkedin, target="_blank", rel="noopener", data-title="LinkedIn")
                  i.fab.fa-linkedin
              if theme.social.bilibili
                a.social-link(href=theme.social.bilibili, target="_blank", rel="noopener", data-title="Bilibili")
                  i.fab.fa-bilibili
              if theme.social.email
                a.social-link(href=theme.social.email, data-title="Email")
                  i.fas.fa-envelope
              if config.feed && config.feed.path
                a.social-link(href=url_for(config.feed.path), target="_blank", rel="noopener", data-title="RSS")
                  i.fas.fa-rss
            if theme.author_card.button_text && theme.author_card.button_link
              .author-cta
                //- 按钮文字是 _config.yml 配置中文,值索引翻译(如"关于我"→nav.about_me)
                a.author-button(href=url_for(theme.author_card.button_link), data-i18n-value=theme.author_card.button_text)= theme.author_card.button_text

      //- 拉绳台灯开关:点击收起/展开上方名片。data-title/aria-label 的初始值
      //- 由 lang-switch 按 author_card.hide 词条填充(见 main.js setLabel),
      //- 这里不再写死中文
      .author-card-pull-cord(
        role="button",
        tabindex="0"
      )&attributes(ta('data-title', 'author_card.hide'), ta('aria-label', 'author_card.hide'))
        span.pull-cord-line
        span.pull-cord-knob
