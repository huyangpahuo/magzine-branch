//- 关于页面布局(pjax 友好 fragment:不含 html/head/body 外壳)
//- ★ 不要加 doctype/html/body:完整文档里多余的 </body> 会把波浪/页脚/
//-   桌宠/全部脚本"吸进" main.main,pjax 换页时会被整体搬走复制。
//- 样式已抽离到 css/about.css,脚本已抽离到 js/about.js
//- (均由 layout.pug 全局加载,适配 pjax)

main.about-page
  #background-shapes

  .about-container
    //- 头部
    .about-header
      .about-avatar
        img(src=url_for(theme.author_card && theme.author_card.avatar ? theme.author_card.avatar : '/img/avatar.png'), alt="Avatar")
      h1.about-name= theme.author_card && theme.author_card.name ? theme.author_card.name : 'Your Name'
      p.about-bio= theme.author_card && theme.author_card.bio ? theme.author_card.bio : 'Your Bio'

    //- 卡片展示区 (保持不变)
    .interests-showcase
      if site.data.about && site.data.about.cards
        each card in site.data.about.cards
          - var cardClass = 'interest-card'
          - if (card.layout) cardClass += ' card-' + card.layout
          - if (card.size) cardClass += ' card-' + card.size

          a(class=cardClass, href=card.link || '#', target="_blank")
            - var bgStyle = card.image ? `background-image: url(${url_for(card.image)});` : `background: ${card.background};`
            .card-bg(style=`${bgStyle} background-size: cover; background-position: center;`)

            .card-content
              h3.card-title= card.title
              .card-description
                p= card.description
              .card-icon
                i(class=card.icon)
              .card-hover-content
                p= card.details
      else
         p(style="text-align:center; opacity:0.6") 暂无数据
    //- 详情区域
    .about-details

      //- 1. 关于我
      //- 1. 关于我 (自适应贴纸布局)
      .about-section
        h2 关于我
        .intro-card-wrapper
          //- 背景图片层
          .intro-banner-bg
            img(src=url_for(theme.author_card && theme.author_card.intro_banner ? theme.author_card.intro_banner : '/images/1.png'), alt="Banner", onerror="this.style.display='none'")
            .banner-overlay

          //- 内容层：现在由它来撑开高度
          .profile-info-content
            .profile-item(data-label="称呼") 胡杨怕火
            .profile-item(data-label="年龄") 19岁
            .profile-item(data-label="大学") 河南师范大学软件工程
            .profile-item(data-label="爱好") 做游戏和绘画
            .profile-item(data-label="擅长") 吃饱睡睡饱吃
            .profile-item(data-label="身份") 二次元爱好者

      //- 2. 我的技能点
      .about-section
        h2 我的技能点
        .interest-cloud
          span.tag 摄影和剪辑
          span.tag 像素画和二次元绘画
          span.tag Logo和矢量图设计
          span.tag 各种计算机语言
          span.tag Blender建模
          span.tag Linux
          span.tag 计算机图形学
          span.tag 微信小程序
          span.tag AI
          span.tag 游戏制作
          span.tag 写小说
          span.tag 我的世界模组制作
          span.tag 英语
          span.tag 日语
          span.tag 前端和数据库
          span.tag 安卓应用制作

      //- 3. 碎碎念
      .about-section
        h2 碎碎念
        .bio-content(style="white-space: pre-wrap;")
          != page.content

      //- 4. 联系方式
      .about-section
        h2 联系方式
