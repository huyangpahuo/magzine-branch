//- 关于页面布局(pjax 友好 fragment:不含 html/head/body 外壳)
//- ★ 不要加 doctype/html/body:完整文档里多余的 </body> 会把波浪/页脚/
//-   桌宠/全部脚本"吸进" main.main,pjax 换页时会被整体搬走复制。
//- 样式已抽离到 css/about.css,脚本已抽离到 js/about.js
//- (均由 layout.pug 全局加载,适配 pjax)

main.about-page
  #background-shapes

  .about-container
    //- 头部
    //- name_en / bio_en: 主题配置里可选的英文名与英文简介(见 _config.yml 的 author_card)
    .about-header
      .about-avatar
        img(src=url_for(theme.author_card && theme.author_card.avatar ? theme.author_card.avatar : '/img/avatar.png'), alt="Avatar")
      - var authorName = theme.author_card && theme.author_card.name ? theme.author_card.name : 'Your Name'
      - var authorBio = theme.author_card && theme.author_card.bio ? theme.author_card.bio : 'Your Bio'
      h1.about-name(data-i18n-zh=authorName, data-i18n-value=authorName)&attributes(i18n_attrs(theme.author_card || {}, 'name'))= authorName
      p.about-bio(data-i18n-zh=authorBio, data-i18n-value=authorBio)&attributes(i18n_attrs(theme.author_card || {}, 'bio'))= authorBio

    //- 卡片展示区 (保持不变)
    .interests-showcase
      if site.data.about && site.data.about.cards
        each card in site.data.about.cards
          - var cardClass = 'interest-card'
          - if (card.layout) cardClass += ' card-' + card.layout
          - if (card.size) cardClass += ' card-' + card.size

          a(class=cardClass, href=card.link || '#', target="_blank")
            - var bgStyle = card.image ? `background-image: url(${url_for(card.image)});` : `background: ${card.background};`
            .card-bg(style=`${bgStyle} background-size: cover; background-position: center;`)

            .card-content
              h3.card-title(data-i18n-zh=card.title)&attributes(i18n_attrs(card, 'title'))= card.title
              .card-description
                p(data-i18n-zh=card.description)&attributes(i18n_attrs(card, 'description'))= card.description
              .card-icon
                i(class=card.icon)
              .card-hover-content
                p(data-i18n-zh=card.details)&attributes(i18n_attrs(card, 'details'))= card.details
      else
         p(style="text-align:center; opacity:0.6")&attributes(t('about.no_data'))= zh('about.no_data')
    //- 详情区域
    .about-details

      //- 1. 关于我 (自适应贴纸布局)
      .about-section
        h2&attributes(t('about.me'))= zh('about.me')
        .intro-card-wrapper
          //- 背景图片层
          .intro-banner-bg
            img(src=url_for(theme.author_card && theme.author_card.intro_banner ? theme.author_card.intro_banner : '/images/1.png'), alt="Banner", onerror="this.style.display='none'")
            .banner-overlay

          //- 内容层：现在由它来撑开高度
          //- ★ 个人资料是会增删的词条:数据在 source/_data/about.yml 的 profile,
          //-   每条自带可选 _en/_ja/_ru 字段(label 左侧灰字 + value 正文)
          .profile-info-content
            if site.data.about && site.data.about.profile
              each item in site.data.about.profile
                .profile-item(data-label=item.label, data-i18n-zh=item.value)&attributes(i18n_attrs(item, 'value'), i18n_attrs(item, 'label', 'data-label'))= item.value

      //- 2. 我的技能点
      .about-section
        h2&attributes(t('about.skills_title'))= zh('about.skills_title')
        .interest-cloud
          if site.data.about && site.data.about.skills
            each item in site.data.about.skills
              span.tag(data-i18n-zh=item.name)&attributes(i18n_attrs(item, 'name'))= item.name

      //- 3. 碎碎念
      .about-section
        h2&attributes(t('about.murmur'))= zh('about.murmur')
        .bio-content(style="white-space: pre-wrap;")
          != page.content

      //- 4. 联系方式
      .about-section
        h2&attributes(t('about.contact'))= zh('about.contact')
        .contact-info
          a.contact-item(href="mailto:3930088367@qq.com")
            i.fas.fa-envelope
            div
              .contact-label&attributes(t('about.contact_email'))= zh('about.contact_email')
              .contact-value 3930088367@qq.com
          a.contact-item(href="https://github.com/huyangpahuo")
            i.fab.fa-github
            div
              .contact-label GitHub
              .contact-value huyangpahuo
          a.contact-item(href="https://space.bilibili.com/3546621941910044")
            i.fas.fa-tv
            div
              .contact-label&attributes(t('about.contact_bilibili'))= zh('about.contact_bilibili')
              .contact-value(data-i18n-value="胡杨怕火") 胡杨怕火

