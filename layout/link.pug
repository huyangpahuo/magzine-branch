//- Link Page Layout
//- 友链页面设计，展示友情链接
//- 样式已抽离到 css/link.css(layout.pug 全局加载,适配 pjax)

//- 页面主结构开始
main.link-page
  .link-header
    h1&attributes(t('link.portals'))= zh('link.portals')
    p.link-description&attributes(t('link.slogan'))= zh('link.slogan')

  .link-categories
    if site.data.link
      .link-grid
        each item, idx in site.data.link
          //- ★ 整卡是一个 <a>:点击卡片任意位置即可跳转
          a.link-card(href=item.link, target="_blank", rel="noopener", data-link-url=item.link, data-idx=idx)
            .link-card-inner
              .link-avatar(style="width: 60px; height: 60px; border-radius: 50%; overflow: hidden; flex-shrink: 0;")
                img(src=item.avatar, alt=item.name, width="60", height="60", style="width: 100%; height: 100%; object-fit: cover;", data-fallback=url_for(theme.author_card && theme.author_card.avatar ? theme.author_card.avatar : '/images/0.png'))&attributes(i18n_attrs(item, 'name', 'alt'))
              .link-info
                h3.link-name(data-i18n-zh=item.name)&attributes(i18n_attrs(item, 'name'))= item.name
                span.link-status(aria-hidden="true")
                span.link-avatar-missing&attributes(t('link.avatar_missing'))= zh('link.avatar_missing')
            .link-tooltip
              .tooltip-content
                h4(data-i18n-zh=item.name)&attributes(i18n_attrs(item, 'name'))= item.name
                p(data-i18n-zh=item.description)&attributes(i18n_attrs(item, 'description'))= item.description
    else
      .no-links
        p&attributes(t('link.empty'))= zh('link.empty')

    // 添加友链板块
    .add-link-section
      .add-link-card
        h3.add-link-title&attributes(t('link.add'))= zh('link.add')
        .add-link-content
          p&attributes(t('link.welcome'))= zh('link.welcome')
          ol.add-link-rules
            li
              span.rule-text&attributes(t('link.my_info'))= zh('link.my_info')
              button.copy-link-info(type="button", data-copy-target="my-link-info", data-title="复制友链信息")&attributes(ta('data-title', 'link.copy_info'))
                i.far.fa-copy
                span&attributes(t('common.copy'))= zh('common.copy')
            pre.code-block#my-link-info
              code.
                - name: 胡杨怕火
                  link: https://funingna-wakawaka.github.io/
                  avatar: https://funingna-wakawaka.github.io/images/0.png
                  description: 传递笑容魔法的Ciallo～(∠・ω< )⌒☆
            li
              span.rule-text&attributes(t('link.rule_anyone'))= zh('link.rule_anyone')
            li
              span.rule-text&attributes(t('link.rule_template'))= zh('link.rule_template')
              button.copy-link-info(type="button", data-copy-target="link-template", data-title="复制模板")&attributes(ta('data-title', 'link.copy_template'))
                i.far.fa-copy
                span&attributes(t('common.copy'))= zh('common.copy')
            pre.code-block#link-template
              code.
                - name: 
                  link: 
                  avatar: 
                  description: 
          p&attributes(t('link.watch_forever'))= zh('link.watch_forever')

    // 评论区域
    .comments-section
      include _partial/comments