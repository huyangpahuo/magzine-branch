//- Link Page Layout
//- 友链页面设计，展示友情链接
//- 样式已抽离到 css/link.css(layout.pug 全局加载,适配 pjax)

//- 页面主结构开始
main.link-page
  .link-header
    h1 传送门
    p.link-description 有志者事竟成多么美好的世界呀

  .link-categories
    if site.data.link
      .link-grid
        each item, idx in site.data.link
          //- ★ 整卡是一个 <a>:点击卡片任意位置即可跳转
          a.link-card(href=item.link, target="_blank", rel="noopener", data-link-url=item.link, data-idx=idx)
            .link-card-inner
              .link-avatar(style="width: 60px; height: 60px; border-radius: 50%; overflow: hidden; flex-shrink: 0;")
                img(src=item.avatar, alt=item.name, width="60", height="60", style="width: 100%; height: 100%; object-fit: cover;", data-fallback=url_for(theme.author_card && theme.author_card.avatar ? theme.author_card.avatar : '/images/0.png'))
              .link-info
                h3.link-name= item.name
                span.link-status(aria-hidden="true")
                span.link-avatar-missing 头像跑掉了~
            .link-tooltip
              .tooltip-content
                h4= item.name
                p= item.description
    else
      .no-links
        p 暂无友链数据，请在 source/_data/link.yml 中添加友链信息

    // 添加友链板块
    .add-link-section
      .add-link-card
        h3.add-link-title 添加友链
        .add-link-content
          p 欢迎大家添加友链哦：
          ol.add-link-rules
            li
              span.rule-text 这是我的友链 ~(=^_^)ノ☆ ：
              button.copy-link-info(type="button", data-copy-target="my-link-info", data-title="复制友链信息")
                i.far.fa-copy
                span 复制
            pre.code-block#my-link-info
              code.
                - name: 胡杨怕火
                  link: https://funingna-wakawaka.github.io/
                  avatar: https://funingna-wakawaka.github.io/images/0.png
                  description: 传递笑容魔法的Ciallo～(∠・ω< )⌒☆
            li
              span.rule-text 只要你们愿意看我的中二文章都可以添加我的友链哦
            li
              span.rule-text 使用以下模板在评论区告诉我你的友链😃我一定会看的!：
              button.copy-link-info(type="button", data-copy-target="link-template", data-title="复制模板")
                i.far.fa-copy
                span 复制
            pre.code-block#link-template
              code.
                - name: 
                  link: 
                  avatar: 
                  description: 
          p 我会一直视奸你们的哈哈哈  o(￣ヘ￣o＃) ~

    // 评论区域
    .comments-section
      include _partial/comments