//- Murmur Page Layout
//- 碎碎念页面，记录短随记
//- 样式已抽离到 css/murmur.css(layout.pug 全局加载,适配 pjax)
//- 视频解析已抽离到 scripts/murmur-video.js(helper: parse_murmur_video)

-
  var murmurCfg = theme.murmur || {}
  var bannerCfg = murmurCfg.banner || {}
  var bannerOn = bannerCfg.enable !== false
  var avatarSrc = theme.author_card && theme.author_card.avatar ? theme.author_card.avatar : '/images/0.png'
  var bannerText = theme.hero && theme.hero.typing_text ? theme.hero.typing_text : '有志者事竟成多么美好的世界呀'

main.murmur-page
  //- 顶部横幅
  if bannerOn
    .murmur-banner
      .murmur-banner-bg
        img(src=url_for(bannerCfg.background_image || '/images/1.webp'), alt="Banner", onerror="this.style.display='none'")
        .banner-gradient
      .murmur-banner-title
        h1 万花筒
      .murmur-banner-meta
        .murmur-banner-avatar
          img(src=url_for(avatarSrc), alt="Avatar")
        .murmur-banner-text
          p= bannerText

  //- 碎碎念内容区
  .murmur-container
    if site.data.murmur && site.data.murmur.length
      .murmur-waterfall
        each item in site.data.murmur
          .murmur-card
            .murmur-card-inner
              .murmur-card-content
                if item.content
                  p.murmur-text!= item.content
                if item.images && item.images.length
                  .murmur-images(class=item.images.length > 1 ? 'murmur-images-grid' : 'murmur-images-single')
                    each img, idx in item.images
                      img.murmur-img(src=url_for(img), alt="图片 " + (idx + 1), loading="lazy")
                
                if item.video
                  - var vData = parse_murmur_video(item.video, item)
                  if vData && vData.unsupported
                    p.murmur-unsupported= vData.unsupported
                  else if vData && vData.html
                    //- 富卡片嵌入(TikTok/Instagram/Facebook)或虎牙点击加载占位卡
                    .murmur-video-embed!= vData.html
                  else if vData && vData.src
                    .murmur-video.hexo-video-embed.murmur-video-normal
                      iframe(src=vData.src, frameborder="0", allowfullscreen="allowfullscreen", referrerpolicy=vData.referrerPolicy, allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen", title="嵌入视频")
              
              .murmur-card-footer
                span.murmur-date
                  i.far.fa-clock
                  = item.date
                if item.location
                  span.murmur-location
                    i.fas.fa-map-marker-alt
                    = item.location
    else
      .murmur-empty
        p 暂无碎碎念，去记录点什么吧~

