//- Category Page
.post-wrapper
  article.post-container
    .post-header
      h1.post-title= page.title || zh('category.related')
      .post-subtitle
        span&attributes(t('category.discover'))= zh('category.discover')
        |  "#{page.category}" 
        span&attributes(t('category.related_posts'))= zh('category.related_posts')

    .category-content
      if page.posts && page.posts.length
        .category-posts
          .category-header
            .category-info
              h2.category-name 
                i.fas.fa-folder
                |  #{page.category}
              .category-description
                span&attributes(t('common.total'))= zh('common.total')
                |  #{page.posts.length} 
                span&attributes(t('common.posts_unit'))= zh('common.posts_unit')
            .category-back
              a(href="/categories/")
                i.fas.fa-arrow-left
                |  
                span&attributes(t('category.back_to_all'))= zh('category.back_to_all')

          .post-list
            each post, index in page.posts.toArray()
              // 根据索引创建不同大小的卡片
              - var cardSize = (index % 6 === 0) ? 'large' : (index % 3 === 0) ? 'medium' : 'small'
              .post-item(class="post-item--" + cardSize)
                .post-item-inner
                  .post-item-title
                    a(href=url_for(post.path), data-i18n-zh=post.title)&attributes(i18n_attrs(post, 'title'))= post.title
                  .post-item-excerpt
                    if post.excerpt
                      //- 中文原文由 lang-switch.js 首次翻译时自动捕获(此处不写 data-i18n-zh,
                      //- 避免与 Hexo 转义后的文本产生差异)
                      p&attributes(i18n_attrs(post, 'description'))= post.excerpt
                    else
                      // 使用 strip_html 过滤器移除 HTML 标签后再截取文本
                      p!= strip_html(post.content).substring(0, cardSize === 'large' ? 300 : cardSize === 'medium' ? 200 : 100) + '...'
                  .post-item-meta
                    .post-meta-left
                      span.post-date
                        i.far.fa-calendar
                        |  #{date(post.date, "YYYY-MM-DD")}

                      //- 【已调整】分类页卡片改显示文章的标签:
                      //- 原来这里显示分类,但在分类详情页里点了等于原地打转;
                      //- 改成标签后点击即可跳转"相关标签"页,与标签页的对称逻辑一致
                      if post.tags && post.tags.length
                        span.post-tag
                          i.fas.fa-tag
                          a(href=url_for(post.tags.first().path))= post.tags.first().name

                    .post-meta-right
                      a.read-more(href=url_for(post.path))
                        span&attributes(t('post.read_full'))= zh('post.read_full')
                        i.fas.fa-arrow-right
      else
        .no-posts
          .empty-state
            i.fas fa-inbox
            h3&attributes(t('category.no_posts'))= zh('category.no_posts')
            p&attributes(t('categories.try_other_or_home'))= zh('categories.try_other_or_home')
            a.button(href="/")&attributes(t('common.back_home'))= zh('common.back_home')