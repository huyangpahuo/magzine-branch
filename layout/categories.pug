//- Categories Page - 支持展开式和跳转式两种布局
.post-wrapper
  article.post-container
    .post-header
      h1.post-title= page.title || 'Categories'
      .post-subtitle&attributes(t(theme.categories.layout === 'accordion' ? 'category.all' : 'category.browse_all'))= theme.categories.layout === 'accordion' ? zh('category.all') : zh('category.browse_all')

    .categories-content
      if page.category
        // 显示特定分类的文章列表 - 跳转式布局
        .category-posts
          .category-header
            .category-info
              h2.category-name
                i.fas.fa-folder
                |  #{page.category}
              //- 第一处 (特定分类头):
              .category-description 
              span&attributes(t('common.total'))= zh('common.total')
              |  #{page.posts ? page.posts.length : 0} 
              span&attributes(t('common.posts_unit'))= zh('common.posts_unit')
            .category-back
              a(href="/categories/")
                i.fas.fa-arrow-left
                |  
                span&attributes(t('category.back_to_all'))= zh('category.back_to_all')

          if page.posts && page.posts.length
            .post-list
              each post in page.posts.toArray()
                .post-item
                  .post-item-inner
                    .post-item-title
                      a(href=url_for(post.path), data-i18n-zh=post.title)&attributes(i18n_attrs(post, 'title'))= post.title
                    .post-item-meta
                      .post-meta-left
                        span.post-date
                          i.far.fa-calendar
                          |  #{date(post.date, "YYYY-MM-DD")}
                      .post-meta-right
                        a.read-more(href=url_for(post.path))
                          span&attributes(t('post.read_full'))= zh('post.read_full')
                          i.fas.fa-arrow-right
          else
            .no-posts
              .empty-state
                i.fas fa-inbox
                h3&attributes(t('category.no_posts'))= zh('category.no_posts')
                p&attributes(t('categories.try_other_or_home'))= zh('categories.try_other_or_home')
                a.button(href="/")&attributes(t('common.back_home'))= zh('common.back_home')
      else if theme.categories.layout === 'accordion'
        // 展开式分类布局
        if site.categories && site.categories.length
          //- 合并大小写/空格差异造成的重复分类(如 hexo 与 Hexo,见 scripts/merge-categories.js)
          - var sortedCategories = merged_categories()

          //- 电脑端视图切换工具栏(竖排 / 文件夹,由 categories-explorer.js 接管)
          if theme.categories.explorer !== false
            .categories-view-toolbar
              button.cx-mode-btn(type="button", data-mode="classic")
                i.fas.fa-align-left
                span&attributes(t('categories_view.list'))= zh('categories_view.list')
              button.cx-mode-btn(type="button", data-mode="explorer")
                i.fas.fa-folder
                span&attributes(t('categories_view.folders'))= zh('categories_view.folders')

          .categories-accordion
            each category, index in sortedCategories
              // 根据配置决定是否显示没有文章的分类
              if category.posts && category.posts.length || theme.categories.show_empty_categories
                - var size = category && category.posts && category.posts.length > 10 ? 'large' : (category && category.posts && category.posts.length > 5 ? 'medium' : 'small')
                .category-section(class="category-section--" + size, data-category=category.name)
                  .category-header
                    .category-info
                      h2.category-name
                        i.fas.fa-folder
                        |  #{category.name}
                      //- 第二处 (Accordion 列表里):
                      .category-description
                        span&attributes(t('common.total'))= zh('common.total')
                        |  #{category.posts ? category.posts.length : 0} 
                        span&attributes(t('common.posts_unit'))= zh('common.posts_unit')
                    .category-toggle
                      i.fas.fa-chevron-down

                  if category.posts && category.posts.length
                    .category-posts(style="display: none;")
                      .post-list
                        each post in category.posts
                          .post-item
                            .post-item-inner
                              .post-item-title
                                a(href=url_for(post.path), data-i18n-zh=post.title)&attributes(i18n_attrs(post, 'title'))= post.title
                              .post-item-meta
                                .post-meta-left
                                  span.post-date
                                    i.far.fa-calendar
                                    |  #{date(post.date, "YYYY-MM-DD")}
                                .post-meta-right
                                  a.read-more(href=url_for(post.path))
                                    span&attributes(t('post.read_full'))= zh('post.read_full')
                                    i.fas.fa-arrow-right
                  else
                    .no-posts(style="display: none;")
                      .empty-state
                        i.fas fa-inbox
                        h3&attributes(t('category.no_posts'))= zh('category.no_posts')
                        p&attributes(t('categories.try_other'))= zh('categories.try_other')

          //- 文件夹视图(仅电脑端显示,手机端由 CSS 强制回退竖排):
          //- 左侧分类文件夹列表,右侧当前分类的文章卡片,支持网格/列表两种排列,
          //- 侧边栏与内容区之间的分隔条可拖动调宽(见 categories-explorer.js)
          if theme.categories.explorer !== false
            - var cxUseDefault = theme.theme_config.post && theme.theme_config.post.use_default_cover !== false
            - var cxDefaultCover = theme.theme_config.post && theme.theme_config.post.default_cover ? theme.theme_config.post.default_cover : '/images/19.png'
            .categories-explorer
              .cx-sidebar
                .cx-folder-list
                  each category, ci in sortedCategories
                    if category.posts && category.posts.length || theme.categories.show_empty_categories
                      button.cx-folder(type="button", class=ci === 0 ? "active" : "", data-name=category.name)
                        i.fas.fa-folder
                        span.cx-folder-name= category.name
                        span.cx-folder-count= category.posts ? category.posts.length : 0
              .cx-resizer
              .cx-main
                .cx-main-header
                  .cx-main-title
                    i.fas.fa-folder-open
                    span.cx-main-name= sortedCategories[0] ? sortedCategories[0].name : ''
                    span.cx-main-count= sortedCategories[0] && sortedCategories[0].posts ? sortedCategories[0].posts.length : 0
                  .cx-header-actions
                    .cx-sort-toggle
                      button.cx-sort-btn(type="button", data-sort="date")&attributes(t('categories_view.sort_date'))= zh('categories_view.sort_date')
                      button.cx-sort-btn(type="button", data-sort="alpha")&attributes(t('categories_view.sort_name'))= zh('categories_view.sort_name')
                    .cx-layout-toggle
                      button.cx-layout-btn(type="button", data-layout="grid")
                        i.fas.fa-th-large
                      button.cx-layout-btn(type="button", data-layout="list")
                        i.fas.fa-list
                .cx-items
                  each category, ci in sortedCategories
                    if category.posts && category.posts.length || theme.categories.show_empty_categories
                      .cx-pane(class=ci === 0 ? "active" : "", data-name=category.name)
                        if category.posts && category.posts.length
                          each post in category.posts
                            - var cxCover = post.cover ? (post.cover.indexOf('/') === 0 ? post.cover : post.path.replace(/\\/g, '/').split('/').slice(0, -1).join('/') + '/' + post.cover) : (cxUseDefault ? cxDefaultCover : null)
                            a.cx-item(href=url_for(post.path))
                              .cx-thumb-wrap
                                if cxCover
                                  img.cx-thumb(src=url_for(cxCover), alt=post.title, loading="lazy")&attributes(i18n_attrs(post, 'title', 'alt'))
                                else
                                  i.fas.fa-file-lines.cx-thumb-icon
                              span.cx-item-name(data-i18n-zh=post.title)&attributes(i18n_attrs(post, 'title'))= post.title
                              span.cx-item-date= date(post.date, "YYYY-MM-DD")
                        else
                          .cx-empty&attributes(t('category.no_posts'))= zh('category.no_posts')
        else
          .no-categories
            .empty-state
              i.fas fa-folder
              h3&attributes(t('category.empty'))= zh('category.empty')
              p&attributes(t('category.start_adding'))= zh('category.start_adding')
              a.button(href="/")&attributes(t('common.back_home'))= zh('common.back_home')
      else
        // 跳转式分类布局 - 显示所有分类的分类云
        .categories-header

        if site.categories && site.categories.length
          .categories-cloud
            - var sortedCategories = site.categories.toArray().sort(function(a, b) { return (b.posts ? b.posts.length : 0) - (a.posts ? a.posts.length : 0); })
            each category in sortedCategories
              // 根据配置决定是否显示没有文章的分类
              if category.posts && category.posts.length || theme.categories.show_empty_categories
                - var size = category && category.posts && category.posts.length > 10 ? 'large' : (category && category.posts && category.posts.length > 5 ? 'medium' : 'small')
                a.category-cloud-item(class="category-cloud-item--" + size, href=url_for(category.path))
                  span.category-name= category.name
                  span.category-count= category.posts ? category.posts.length : 0
        else
          .no-categories
            .empty-state
              i.fas fa-folder
              h3&attributes(t('category.empty'))= zh('category.empty')
              p&attributes(t('category.start_adding'))= zh('category.start_adding')
              a.button(href="/")&attributes(t('common.back_home'))= zh('common.back_home')
