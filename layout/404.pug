//- 404 Page Layout (pjax 友好 fragment:不含 html/head/body 外壳)
//- 样式已抽离到 css/404.css(layout.pug 全局加载,适配 pjax)

main.notfound-page
  //- 漂浮装饰背景
  .nf-bg
    span.nf-cloud.c1
    span.nf-cloud.c2
    span.nf-cloud.c3
    span.nf-star.s1 ★
    span.nf-star.s2 ★
    span.nf-star.s3 ★
    span.nf-star.s4 ✦

  .nf-card
    //- 迷路的桌宠(纯 CSS 动效)
    .nf-pet
      .nf-pet-body
        .nf-pet-face
          span.nf-eye.left
          span.nf-eye.right
          span.nf-mouth
        .nf-pet-arm.left
        .nf-pet-arm.right
        .nf-shadow

    h1.nf-code(aria-label='404')
      span.d1 4
      span.d0 0
      span.d2 4
    p.nf-title&attributes(t('error404.title'))= zh('error404.title')
    p.nf-desc
      span&attributes(t('error404.desc'))= zh('error404.desc')
      br
      span&attributes(t('error404.back_home'))= zh('error404.back_home')

    .nf-actions
      a.nf-btn.primary(href='/')
        i.fas.fa-home
        span&attributes(t('common.back_home'))= zh('common.back_home')
      a.nf-btn.ghost(href='/archives/')
        i.fas.fa-compass
        span&attributes(t('error404.browse_archives'))= zh('error404.browse_archives')

  //- 底部波浪使用主题全局的 #waves-container(layout.pug),
  //- 这里不再重复渲染,避免 404 页出现两层波浪。
