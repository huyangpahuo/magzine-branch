doctype html
html(lang=config.language)
  head
    meta(http-equiv="Content-Type", content="text/html; charset=UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1, maximum-scale=1")
    meta(name="theme-color", content=theme.colors.primary)
    meta(name="msapplication-navbutton-color", content=theme.colors.primary)
    meta(name="apple-mobile-web-app-capable", content="yes")
    meta(name="apple-mobile-web-app-status-bar-style", content="black-translucent")

    title= page_title ? page_title + ' - ' + config.title : config.title

    //- 读者设置:尽早应用浏览器中保存的个性化配置(防闪烁)
    != js('js/core/reader-settings.js')

    //- Dark mode script to prevent flash
    if theme.features && theme.features.dark_mode
      script.
        (function() {
          // 【修改点 1】头部脚本：如果本地存储为空(从未设置过)，默认开启暗色(true)
          var savedDarkMode = localStorage.getItem('darkMode');
          var shouldBeDark = savedDarkMode === null ? true : savedDarkMode === 'true';
          
          if (shouldBeDark) {
            document.documentElement.classList.add('dark-mode');
          }
        })();

    //- ★★★ 新增：检测当前页面是否在 iframe (模态窗口) 中运行，提前打上标签防止闪烁 ★★★
    script.
      if (window.parent !== window) {
        document.documentElement.classList.add('is-iframe');
      }

    //- 字体:移除 Google Fonts(境内不可达且阻塞渲染),回退到字体栈里的系统字体。
    //- 需要 Inter/Playfair Display 时可自行下载子集放入 lib/ 后本地引入。

    //- Font Awesome Icons (本地化,不再依赖 cdnjs)
    link(rel="preload", href=url_for('lib/font-awesome/webfonts/fa-solid-900.woff2'), as="font", type="font/woff2", crossorigin)
    link(rel="stylesheet", href=url_for('lib/font-awesome/all.min.css'))

    //- RSS
    if config.feed && config.feed.path
      link(rel="alternate", href=url_for(config.feed.path), title=config.title, type="application/atom+xml")

    //- Favicon
    link(rel="icon", href=url_for(theme.favicon))

    //- Styles
    != css('css/core/main')
    != css('css/components/tags')
    != css('css/pages/categories')
    != css('css/pages/categories-accordion')
    != css('css/pages/categories-explorer')
    != css('css/components/highlight')
    != css('css/components/toc')
    != css('css/components/image-zoom')
    != css('css/components/mermaid')
    != css('css/components/share')
    != css('css/components/mobile-nav')
    != css('css/components/search')
    != css('css/core/scrollbar')
    != css('css/components/timeline')
    //- ★ animations.css 在主题中不存在(历史遗留引用,每页产生一个 404),已移除
    != css('css/components/ai-theme')
    != css('css/components/loading-animation')
    != css('css/components/article-modal')
    != css('css/components/music-player')
    != css('css/components/table')
    //- 独立页面样式全局加载(均以页面级 class 作作用域,不会互相污染)。
    //- pjax 只替换 main.main,不替换 <head>,这些样式必须常驻,
    //- 否则关于/照片墙/追番页面无感刷新后会丢失样式(关于页背景会错乱)
    //- about.css 已完全以 .about-page / .about-section / .interest-cloud 为作用域,
    //- 可安全常驻,不会污染其他页面(之前曾用条件加载,会导致 pjax 进入关于页丢失样式)
    != css('css/pages/about')
    != css('css/pages/wall')
    != css('css/pages/anime')
    != css('css/pages/link')
    != css('css/pages/murmur')
    != css('css/pages/404')
    != css('css/components/cursor')
    != css('css/components/carousel')


    //- Theme color variables from config
    style.
      :root {
        --primary-color: #{theme.colors.primary};
        --secondary-color: #{theme.colors.secondary};
        --accent-color: #{theme.colors.accent};
        --background-color: #{theme.colors.background};
        --text-color: #{theme.colors.text};
        --overlay-color: #{theme.colors.overlay};
        --tag-background-color: #{theme.colors.tag_background};
        --card-background-color: #{theme.colors.card_background};
      }

    //- Custom head
    if theme.custom_head
      != theme.custom_head

    //- Inject head
    if theme.inject && theme.inject.head
      each item in theme.inject.head
        != item

  body
    //- ★★★ 新增：通过配置文件判断是否开启封面 ★★★
    if theme.cover && theme.cover.enable
      != partial('_partial/cover')
    #app
      != partial('_partial/header')

      //- ★★★ 修改为：通过配置文件判断是否开启右上角色卡 ★★★
      if theme.color_picker && theme.color_picker.enable
        != partial('_partial/color-picker')
        
      != partial('_partial/search')

      main.main
        != body

      //- ★★★ 新增：通过配置文件判断是否开启 Sakana ★★★
      if theme.sakana && theme.sakana.enable
        != partial('_partial/sakana')


      //- ★★★ 新增：波浪效果容器 (紧贴 Footer 上方) ★★★
      #waves-container
        svg.waves(xmlns="http://www.w3.org/2000/svg", xmlns:xlink="http://www.w3.org/1999/xlink", viewBox="0 24 150 28", preserveAspectRatio="none", shape-rendering="auto")
          defs
            path#gentle-wave(d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z")
          g.parallax
            use(xlink:href="#gentle-wave", x="48", y="0")
            use(xlink:href="#gentle-wave", x="48", y="3")
            use(xlink:href="#gentle-wave", x="48", y="5")
            use(xlink:href="#gentle-wave", x="48", y="7")

      != partial('_partial/footer')
      //- ★★★ 桌面宠物 ★★★
      if theme.pet && theme.pet.enable
        != partial('_partial/pet')

    if theme.music_player && theme.music_player.enable
      != partial('_partial/music-player')
      
    // 立即应用暗色模式，避免页面闪烁
    if theme.features && theme.features.dark_mode
      script.
        (function() {
          var savedDarkMode = localStorage.getItem('darkMode');
          var shouldBeDark = savedDarkMode === null ? true : savedDarkMode === 'true';

          if (shouldBeDark) {
            document.body.classList.add('dark-mode');
          }
          // ★ 性能修改:删除了原先 "visibility:hidden 直到 DOMContentLoaded" 的白屏锁。
          //   它会把所有阻塞资源的耗时叠加成整页白屏;暗色防闪已由 <head> 里的
          //   documentElement.classList 提前完成,不再需要整页隐藏。
        })();

    //- Scripts
    //- ★ 性能修改:全部加 defer——不阻塞 HTML 解析,首屏文字可以先渲染;
    //-   defer 保持文档顺序执行,且仍在 DOMContentLoaded 之前跑完,
    //-   各脚本里监听 DOMContentLoaded 的初始化逻辑不受影响(pjax 换页也会重新派发该事件)。
    script(defer, src=url_for('js/core/main.js'))
    //- ★ 内容按视口加载:代码块/表格/图表/公式/视频离屏不渲染(模态与直链通用)
    script(defer, src=url_for('js/content/content-lazy.js'))
    script(defer, src=url_for('js/content/tags.js'))
    script(defer, src=url_for('js/pages/categories-accordion.js'))
    script(defer, src=url_for('js/pages/categories-explorer.js'))
    script(defer, src=url_for('js/content/highlight.js'))
    script(defer, src=url_for('js/core/load-more.js'))
    script(defer, src=url_for('js/core/header-scroll.js'))
    script(defer, src=url_for('js/content/toc.js'))
    script(defer, src=url_for('js/content/image-zoom.js'))
    script(defer, src=url_for('js/content/mermaid.js'))
    script(defer, src=url_for('js/content/share.js'))
    script(defer, src=url_for('js/features/search.js'))
    script(defer, src=url_for('js/content/hide-inline-interaction.js'))
    script(defer, src=url_for('js/content/hide-toggle-interaction.js'))
    script(defer, src=url_for('js/core/dark-mode-sync.js'))
    //- js/animations.js 在主题中不存在(历史遗留引用,每页产生一个 404),已移除
    script(defer, src=url_for('js/features/ai-theme.js'))
    script(defer, src=url_for('js/core/loading-animation.js'))
    script(defer, src=url_for('js/features/article-modal.js'))
    script(defer, src=url_for('js/features/music-player.js'))
    script(defer, src=url_for('js/pages/wall.js'))
    script(defer, src=url_for('js/pages/anime.js'))
    script(defer, src=url_for('js/pages/about.js'))
    script(defer, src=url_for('js/pages/link.js'))
    script(defer, src=url_for('js/pages/shake-shuffle.js'))
    script(defer, src=url_for('js/pages/random-cards.js'))
    script(defer, src=url_for('js/content/table.js'))
    script(defer, src=url_for('js/content/video-embed.js'))
    script(defer, src=url_for('js/core/mobile-scale.js'))
    script(defer, src=url_for('js/pages/carousel.js'))

    //- 阿尼亚自定义鼠标指针(帧数据由转换脚本生成;可在 config.yml 关闭)
    if theme.cursor && theme.cursor.enable
      script(defer, src=url_for('cursors/anya/data.js'))
      script(defer, src=url_for('js/effects/anya-cursor.js'))

    //- PJAX 无感刷新(自研实现,放最后加载;可在 config.yml 关闭)
    if theme.pjax && theme.pjax.enable !== false
      script(defer, src=url_for('js/core/pjax-init.js'))

    //- 刚读过的文章置顶(可在 config.yml 关闭)
    if theme.just_read && theme.just_read.enable !== false
      script(defer, src=url_for('js/features/just-read.js'))

    // 传递图片配置给 JS
    script.
      window.photoWallImages = !{JSON.stringify(theme.photo_wall.images || [])};
      window.twikooEnvId = '#{theme.comments.twikoo.envId}';
      
      

    //- Theme configuration for JavaScript
    script.
      window.theme = (function () {
        var base = {
        image_viewer: !{JSON.stringify(theme.image_viewer || {})},
        reader_settings: !{JSON.stringify(theme.reader_settings || {})},
        music_player: !{JSON.stringify(theme.music_player || {})},
        navbar: !{JSON.stringify(theme.navbar || {})},
        color_picker: !{JSON.stringify(theme.color_picker || {})},
        cover: !{JSON.stringify(theme.cover || {})},
        hero: !{JSON.stringify(theme.hero || {})},
        pjax: !{JSON.stringify(theme.pjax || {})},
        murmur: !{JSON.stringify(theme.murmur || {})},
        author_card: !{JSON.stringify(theme.author_card || {})},
        sakana: !{JSON.stringify(theme.sakana || {})},
        features: !{JSON.stringify(theme.features)},
        code_block: !{JSON.stringify(theme.code_block)},
        ai_summary: !{JSON.stringify(theme.ai_summary)},
        categories: !{JSON.stringify(theme.categories)},
        article_list: !{JSON.stringify(theme.article_list)},
        just_read: !{JSON.stringify(theme.just_read || {})},
        pet: !{JSON.stringify(theme.pet)},
        anime: !{JSON.stringify(theme.anime)}
        };
        // ★ 原始配置快照(未合并读者设置):设置面板的"选项是否显示"
        //   必须以主题原始配置为准,否则读者关掉某项后选项会自己消失
        window.__themeRaw = JSON.parse(JSON.stringify(base));
        // 深合并读者设置补丁(两级足够)
        Object.keys(window.__readerThemePatch || {}).forEach(function (k) {
          if (
            window.__readerThemePatch[k] &&
            typeof window.__readerThemePatch[k] === "object" &&
            typeof base[k] === "object" &&
            base[k] !== null
          ) {
            base[k] = Object.assign({}, base[k], window.__readerThemePatch[k]);
          } else {
            base[k] = window.__readerThemePatch[k];
          }
        });
        return base;
      })();

    //- Custom scripts
    if theme.custom_scripts
      != theme.custom_scripts

    //- Inject bottom
    if theme.inject && theme.inject.bottom
      each item in theme.inject.bottom
        != item